# Akse Fotograf - Environment Variables
# Bu dosyayi kopyalayip .env.local olarak yeniden adlandirin.
# .env.local zaten .gitignore'da; secret'lar git'e gitmez.

# === Site URL (production) ===
NEXT_PUBLIC_SITE_URL=https://aksefotograf.com

# === Google Analytics 4 ===
NEXT_PUBLIC_GA_ID=G-6BR1SLXSR9

# === Supabase ===
# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co

# Project Settings -> API -> anon public (browser-safe, RLS uyumlu)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# Project Settings -> API -> service_role (GIZLI! sadece server-side)
# RLS bypass eder. Browser'a sizdirmayin. Sadece seed + server actions icin.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# === Resend (iletisim formu mail) ===
# https://resend.com -> API Keys
RESEND_API_KEY=
CONTACT_EMAIL_TO=info@aksefotograf.com
CONTACT_EMAIL_FROM=site@aksefotograf.com

# === Cloudflare R2 (görsel & video CDN) ===
# Cloudflare Dashboard → Account ID (sağ kenar)
R2_ACCOUNT_ID=

# Cloudflare Dashboard → R2 → Manage R2 API Tokens → Create
# Token permission: Object Read & Write, sadece bu bucket'a
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket adı (örn. "akse-media")
R2_BUCKET=akse-media

# Public CDN URL (custom domain bağlandıysa: https://cdn.aksefotograf.com)
# Bağlanmadıysa: https://pub-xxxxxx.r2.dev (bucket public domain)
R2_PUBLIC_URL=https://cdn.aksefotograf.com

# === Microsoft Clarity (opsiyonel heatmap) ===
NEXT_PUBLIC_CLARITY_ID=

# === Google Search Console (HTML meta dogrulama; DNS varsa bos) ===
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# === Cloudflare Turnstile (form spam korumasi, opsiyonel) ===
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# === Google Maps Embed (opsiyonel — iframe geri istenirse) ===
NEXT_PUBLIC_GMAPS_API_KEY=
