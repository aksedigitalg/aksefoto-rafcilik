# Site URL'si (canonical, sitemap, schema icin kullanilir)
NEXT_PUBLIC_SITE_URL=https://aksefotograf.com

# Resend API anahtari (iletisim formu icin)
RESEND_API_KEY=
CONTACT_EMAIL_TO=info@aksefotograf.com
CONTACT_EMAIL_FROM=site@aksefotograf.com

# Google Analytics 4
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity
NEXT_PUBLIC_CLARITY_ID=

# Google Search Console verification (DNS yerine HTML meta kullanilirsa)
